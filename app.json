{
  "expo": {
    "name": "Christ Revealed",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dba903a0-fc8a-4308-9ee8-6b819c626a2d"
      }
    },
    "android": {
      "package": "com.hello_coopearations.boltexponativewind"
    }
  }
}
